# Docker Compose defaults
API_BIND_ADDRESS=127.0.0.1
API_PORT=8787
TZ=Europe/Berlin

# Internal service URLs for the Docker stack
REDIS_URL=redis://redis:6379/0
DATABASE_URL=sqlite:////data/db.sqlite3
DATA_LOG_DIR=/data/logs
DATA_UPLOAD_DIR=/data/uploads
DATA_OUTPUT_DIR=/data/output
MAX_UPLOAD_BYTES=2147483648
REMOTE_DOWNLOAD_MAX_BYTES=2147483648
OUTPUT_RETENTION_HOURS=24
OUTPUT_CLEANUP_INTERVAL_SECONDS=3600
DOCUMENT_CONVERT_TIMEOUT_SECONDS=120
MEDIA_CONVERT_TIMEOUT_SECONDS=21600

# Large temporary files use private Docker volumes at /scratch (disk backed).
# /tmp holds only small runtime files. Set quotas on the Docker storage dataset.
API_TMPFS_SIZE=64m
# Optional container budgets; 0 leaves the existing unlimited setting unchanged.
# Set only after measuring your largest conversions (example worker: 4g / 2 CPUs).
API_MEMORY_LIMIT=0
API_CPUS=0
WORKER_MEMORY_LIMIT=0
WORKER_CPUS=0
REDIS_MEMORY_LIMIT=0
REDIS_CPUS=0

# Worker tuning
WORKER_CONCURRENCY=1
WORKER_TMPFS_SIZE=64m

# Mandatory fail-closed malware scanning
MALWARE_SCAN_ENABLED=true
CLAMAV_TIMEOUT_SECONDS=900
CLAMAV_IDLE_SECONDS=60
CLAMAV_STARTUP_SECONDS=180
CLAMAV_DATABASE_MAX_AGE_SECONDS=604800
CLAMAV_RETRIES=2
MALWARE_SCAN_MAX_BYTES=2147483648
CLAMAV_MEMORY_LIMIT=3g
CLAMAV_CPUS=2.0
